      "components": [
        { "metric": "moneyRatio", "label": "最終金錢÷開局金錢", "weight": 0.5, "lo": 0.5, "hi": 2.5 },
        { "metric": "positiveNetRate", "label": "淨利為正的季比例", "weight": 0.3, "lo": 0, "hi": 1 },
        { "metric": "pointsUseRate", "label": "點數使用率", "weight": 0.2, "lo": 0.3, "hi": 1 }
      ]
    },
    {
      "id": "welfare", "label": "民生照顧", "short": "民生",
      "desc": "民怨壓得低、人車流量好、店家開得住。",
