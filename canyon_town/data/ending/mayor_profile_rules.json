{
  "id": "mayor_profile_rules",
  "seasonId": "season_01",
  "version": 1,
  "status": "final",
  "note": "Stage H 市長任命狀六軸計分（呆呆 10/7 提案，10/10 咪咪審定：權重、門檻照提案定案）。輸入＝G.BehaviorLog.metrics(log) 的指標＋本檔 derived／new 指標；每個數字為 {value,note}。小力暫用版 data/ending/score_rules.json 已廢止（不再進 embed）；stage_h 改讀 G.DATA.ending。",
  "source": {
    "log": "G.BehaviorLog（src/js/behavior_log.js；localStorage 鍵 catflash.behaviorLog.h1）",
    "metrics": "G.BehaviorLog.metrics(log, rules)（existing 指標）",
    "reference": "tools/ending_profile_ref.js（derived／new 指標與計分參考實作；不放進 src/js）"
  },
  "scale": {
    "min": {
      "value": 0,
      "note": "每軸與總分下限"
    },
    "max": {
      "value": 100,
      "note": "每軸與總分上限"
    }
  },
  "normalize": {
    "method": "linear",
    "formula": "clamp((value − lo) ÷ (hi − lo), 0, 1) × 100",
    "note": "與小力原 score_rules 相同，方便 stage_h.js 直接沿用（見 toStageHRules）"
  },
  "missing": {
    "componentRule": "指標為 null（沒紀錄）→ 不計入分母",
    "axisNoData": {
      "value": 50,
      "note": "整軸沒資料（例如第 1 季就結束任期）→ 50 分並標 noData；小力暫用版是 0"
    },
    "zeroActionRule": "有紀錄但玩家沒有行為（例如整局都按忽略、沒畫重點）是 0，不是沒資料"
  },
  "resultValue": {
    "cure": {
      "value": 1,
      "note": "對症"
    },
    "assist": {
      "value": 0.7,
      "note": "輔助"
    },
    "palliative": {
      "value": 0.4,
      "note": "治標"
    },
    "none": {
      "value": 0,
      "note": "無關"
    },
    "backfire": {
      "value": 0,
      "note": "反效果"
    }
  },
  "axes": [
    {
      "id": "reading",
      "name": "讀報理解",
      "short": "讀報",
      "desc": "把快報讀完、展開重點、花時間讀，而不是急著做決定。",
      "order": 1,
      "weight": {
        "value": 1,
        "note": "總分＝六軸加權平均，目前等權"
      },
      "clamp": {
        "min": {
          "value": 0,
          "note": "下限"
        },
        "max": {
          "value": 100,
          "note": "上限"
        }
      },
      "noDataScore": {
        "value": 50,
        "note": "整軸沒資料時（不羞辱，顯示「資料不足」）"
      },
      "caps": [],
      "components": [
        {
          "metric": "avgScrollPct",
          "label": "平均捲動%",
          "status": "existing",
          "source": "seasons[].paper.maxScrollPct",
          "formula": "有讀報紀錄的季，maxScrollPct 平均",
          "weight": {
            "value": 0.25,
            "note": "捲動只代表有看過，權重較低"
          },
          "lo": {
            "value": 40,
            "note": "捲動%（報紙門檻 72% 一定會過）：低於此值＝0 分"
          },
          "hi": {
            "value": 100,
            "note": "捲動%（報紙門檻 72% 一定會過）：達到此值＝100 分"
          }
        },
        {
          "metric": "avgExpandedRatio",
          "label": "展開篇數比例",
          "status": "existing",
          "source": "seasons[].paper.expanded ÷ seasons[].paper.storyCount",
          "formula": "每季 min(1, expanded÷storyCount) 平均",
          "weight": {
            "value": 0.35,
            "note": "展開報導最能代表「讀懂」"
          },
          "lo": {
            "value": 0,
            "note": "展開比例（展開六成報導就滿分）：低於此值＝0 分"
          },
          "hi": {
            "value": 0.6,
            "note": "展開比例（展開六成報導就滿分）：達到此值＝100 分"
          }
        },
        {
          "metric": "avgReadSec",
          "label": "平均讀報秒數",
          "status": "existing",
          "source": "seasons[].paper.readMs ÷ 1000",
          "formula": "每季讀報秒數平均",
          "weight": {
            "value": 0.2,
            "note": "花時間讀；上限 90 秒避免鼓勵拖延"
          },
          "lo": {
            "value": 20,
            "note": "讀報秒數：低於此值＝0 分"
          },
          "hi": {
            "value": 90,
            "note": "讀報秒數：達到此值＝100 分"
          }
        },
        {
          "metric": "avgHighlights",
          "label": "平均畫重點數",
          "status": "new",
          "source": "seasons[].paper.highlights（需小力新增）",
          "formula": "每季畫重點（.np-clue.is-highlighted）數平均",
          "weight": {
            "value": 0.2,
            "note": "畫重點＝主動找證據"
          },
          "lo": {
            "value": 0,
            "note": "每季畫重點數（3 個就滿分）：低於此值＝0 分"
          },
          "hi": {
            "value": 3,
            "note": "每季畫重點數（3 個就滿分）：達到此值＝100 分"
          }
        }
      ],
      "example": {
        "metrics": {
          "avgScrollPct": 85,
          "avgExpandedRatio": 0.4,
          "avgReadSec": 55,
          "avgHighlights": null
        },
        "parts": [
          {
            "metric": "avgScrollPct",
            "value": 85,
            "score": 75
          },
          {
            "metric": "avgExpandedRatio",
            "value": 0.4,
            "score": 67
          },
          {
            "metric": "avgReadSec",
            "value": 55,
            "score": 50
          },
          {
            "metric": "avgHighlights",
            "value": null,
            "score": null
          }
        ],
        "score": 65,
        "noData": false
      }
    },
    {
      "id": "evidence",
      "name": "證據判斷",
      "short": "證據",
      "desc": "蒐集真線索、分辨傳聞，並用線索支持選卡。",
      "order": 2,
      "weight": {
        "value": 1,
        "note": "總分＝六軸加權平均，目前等權"
      },
      "clamp": {
        "min": {
          "value": 0,
          "note": "下限"
        },
        "max": {
          "value": 100,
          "note": "上限"
        }
      },
      "noDataScore": {
        "value": 50,
        "note": "整軸沒資料時（不羞辱，顯示「資料不足」）"
      },
      "caps": [],
      "components": [
        {
          "metric": "collectRate",
          "label": "真線索蒐集率",
          "status": "existing",
          "source": "Σ seasons[].clues.collected ÷ Σ seasons[].clues.available",
          "formula": "整局加總後相除（上限 1）",
          "weight": {
            "value": 0.35,
            "note": "街景真線索蒐集"
          },
          "lo": {
            "value": 0,
            "note": "蒐集率（八成就滿分）：低於此值＝0 分"
          },
          "hi": {
            "value": 0.8,
            "note": "蒐集率（八成就滿分）：達到此值＝100 分"
          }
        },
        {
          "metric": "trueShare",
          "label": "點選中真線索比例",
          "status": "existing",
          "source": "seasons[].clues.tapped{true,false,partial}",
          "formula": "Σtrue ÷ Σ(true+false+partial)",
          "weight": {
            "value": 0.25,
            "note": "分辨線索和傳聞"
          },
          "lo": {
            "value": 0.3,
            "note": "真線索比例（三成以下＝0）：低於此值＝0 分"
          },
          "hi": {
            "value": 1,
            "note": "真線索比例（三成以下＝0）：達到此值＝100 分"
          }
        },
        {
          "metric": "clueBackedRate",
          "label": "有線索支持的選卡比例",
          "status": "existing",
          "source": "seasons[].decision.clueBacked ÷ played.length",
          "formula": "Σ clueBacked ÷ Σ 出牌數",
          "weight": {
            "value": 0.3,
            "note": "用證據支持決策"
          },
          "lo": {
            "value": 0,
            "note": "有線索支持的選卡比例：低於此值＝0 分"
          },
          "hi": {
            "value": 0.8,
            "note": "有線索支持的選卡比例：達到此值＝100 分"
          }
        },
        {
          "metric": "notEarlyRate",
          "label": "沒有提早結束觀察的比例",
          "status": "existing",
          "source": "seasons[].earlyReport",
          "formula": "1 − 提早結束街景觀察的季數 ÷ 季數",
          "weight": {
            "value": 0.1,
            "note": "街景觀察是蒐證時間，提早結束扣一點"
          },
          "lo": {
            "value": 0.5,
            "note": "沒提早結束的比例（一半以下＝0）：低於此值＝0 分"
          },
          "hi": {
            "value": 1,
            "note": "沒提早結束的比例（一半以下＝0）：達到此值＝100 分"
          }
        }
      ],
      "example": {
        "metrics": {
          "collectRate": 0.5,
          "trueShare": 0.65,
          "clueBackedRate": 0.4,
          "notEarlyRate": 0.75
        },
        "parts": [
          {
            "metric": "collectRate",
            "value": 0.5,
            "score": 63
          },
          {
            "metric": "trueShare",
            "value": 0.65,
            "score": 50
          },
          {
            "metric": "clueBackedRate",
            "value": 0.4,
            "score": 50
          },
          {
            "metric": "notEarlyRate",
            "value": 0.75,
            "score": 50
          }
        ],
        "score": 54,
        "noData": false
      }
    },
    {
      "id": "decision",
      "name": "對症決策",
      "short": "對症",
      "desc": "選卡對症（對症＞輔助＞治標＞無關／反效果），點數花在刀口上，少放著問題不管。",
      "order": 3,
      "weight": {
        "value": 1,
        "note": "總分＝六軸加權平均，目前等權"
      },
      "clamp": {
        "min": {
          "value": 0,
          "note": "下限"
        },
        "max": {
          "value": 100,
          "note": "上限"
        }
      },
      "noDataScore": {
        "value": 50,
        "note": "整軸沒資料時（不羞辱，顯示「資料不足」）"
      },
      "caps": [],
      "components": [
        {
          "metric": "cureScore",
          "label": "選卡判定平均",
          "status": "existing",
          "source": "seasons[].decision.verdicts（resultValue 換算）",
          "formula": "每張卡 cure 1／assist .7／palliative .4／none 0／backfire 0 的平均",
          "weight": {
            "value": 0.5,
            "note": "最核心：卡有沒有對症"
          },
          "lo": {
            "value": 0,
            "note": "判定平均（0.8＝大多對症）：低於此值＝0 分"
          },
          "hi": {
            "value": 0.8,
            "note": "判定平均（0.8＝大多對症）：達到此值＝100 分"
          }
        },
        {
          "metric": "backfireFreeRate",
          "label": "沒有反效果的比例",
          "status": "existing",
          "source": "seasons[].decision.verdicts",
          "formula": "1 − backfire 張數 ÷ 出牌張數",
          "weight": {
            "value": 0.15,
            "note": "避免幫倒忙"
          },
          "lo": {
            "value": 0.5,
            "note": "無反效果比例：低於此值＝0 分"
          },
          "hi": {
            "value": 1,
            "note": "無反效果比例：達到此值＝100 分"
          }
        },
        {
          "metric": "notIgnoreRate",
          "label": "沒有忽略的季比例",
          "status": "existing",
          "source": "seasons[].decision.ignored",
          "formula": "1 − 按忽略的季數 ÷ 有決策紀錄的季數",
          "weight": {
            "value": 0.15,
            "note": "少放著問題不管"
          },
          "lo": {
            "value": 0,
            "note": "沒忽略比例：低於此值＝0 分"
          },
          "hi": {
            "value": 1,
            "note": "沒忽略比例：達到此值＝100 分"
          }
        },
        {
          "metric": "targetPointsRate",
          "label": "點數花在對症／輔助卡的比例",
          "status": "derived",
          "source": "seasons[].decision.played＋verdicts＋pointsAvail；G.DATA.policies[pid].cost",
          "formula": "Σ（verdict 為 cure/assist 的卡 cost）÷ Σ pointsAvail",
          "weight": {
            "value": 0.2,
            "note": "點數用得準，而不是用得多"
          },
          "lo": {
            "value": 0,
            "note": "對症點數比例（六成就滿分）：低於此值＝0 分"
          },
          "hi": {
            "value": 0.6,
            "note": "對症點數比例（六成就滿分）：達到此值＝100 分"
          }
        }
      ],
      "example": {
        "metrics": {
          "cureScore": 0.56,
          "backfireFreeRate": 0.95,
          "notIgnoreRate": 0.9,
          "targetPointsRate": 0.33
        },
        "parts": [
          {
            "metric": "cureScore",
