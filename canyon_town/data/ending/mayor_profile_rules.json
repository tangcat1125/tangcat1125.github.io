            "value": 0.25,
            "note": "季季有盈餘"
          },
          "lo": {
            "value": 0,
            "note": "盈餘季比例（八成就滿分）：低於此值＝0 分"
          },
          "hi": {
            "value": 0.8,
            "note": "盈餘季比例（八成就滿分）：達到此值＝100 分"
          }
        },
        {
          "metric": "wasteFreeRate",
          "label": "沒花在無關卡的比例",
          "status": "new",
