{
  "id": "event_pool_rules_season_01",
  "seasonId": "season_01",
  "version": 1,
  "calendar": {
    "startMonth": 3,
    "monthsPerCycle": 3,
    "seasonByMonth": {
      "3": "spring",
      "4": "spring",
      "5": "spring",
      "6": "summer",
      "7": "summer",
      "8": "summer",
      "9": "autumn",
      "10": "autumn",
      "11": "autumn",
      "12": "winter",
      "1": "winter",
      "2": "winter"
    },
    "labels": {
      "spring": "春",
      "summer": "夏",
      "autumn": "秋",
      "winter": "冬"
    },
    "note": "第 1 個週期 = 三月（春）；每個週期前進 monthsPerCycle 個月。"
  },
  "draw": {
    "countRule": {
      "min": 2,
      "max": 4,
      "base": 2,
      "plusIf": [
        {
          "when": "平均民怨 ≥ 55",
          "plus": 1
        },
        {
          "when": "任一領域 ≥ 75（爆怒）",
          "plus": 1
        }
      ],
      "jitter": {
        "chance": 0.25,
        "plus": 1,
        "onlyIfNoPlus": true
      },
      "teacherOverride": "opts.count"
    },
    "weightFormula": "weight = baseWeight × seasonMult[季節] × Π(weightMods 命中者的 mult) × domainPressure × ignoredBoost",
    "domainPressure": {
      "base": 0.5,
      "perPoint": 0.02,
      "note": "民怨 0→×0.5，50→×1.5，100→×2.5；民怨越高越容易出事。"
    },
    "ignoredBoost": {
      "perStreak": 0.25,
      "note": "該領域連續被忽略的季數 × 0.25 加權。"
    },
    "noRepeat": {
      "sameEventCooldownCycles": 1,
      "maxPerDomainPerCycle": 2,
      "note": "同一事件不連兩季抽到（除非是反彈／連鎖強制出現）；同一領域本季最多 2 個。"
    },
    "forcedPending": {
      "rule": "chain 排入的 pending 事件到期（dueCycle ≤ 本季）一定出現，最多 2 個；超過的順延一季。"
    },
    "maxTotal": 4,
    "requiresFilter": "沒有通過 requires 的事件不進候選；chainOnly 事件只能由連鎖或 requires 命中時以低權重進候選。",
    "opportunityRule": "polarity=opportunity 的事件每季最多 1 個。",
    "falseAlarmRule": "falseAlarm=true 的事件每季最多 1 個。"
  },
  "seed": {
    "type": "string|int",
    "derivation": "rng = mulberry32(xmur3(seed + \"|\" + cycle + \"|\" + purpose))",
    "purposes": [
      "draw",
      "count",
      "vars:<eventId>",
      "chain:<eventId>",
      "schedule"
    ],
    "modes": {
      "adaptive": "預設：權重會看玩家狀態（民怨、已買政策、上季結果）；同 seed 但不同選擇 → 之後的事件會不同。",
      "locked": "教師固定劇本：權重只看季節與基礎權重，忽略玩家狀態與 requires；同 seed 所有學生遇到同一串事件，方便比較政策選擇。locked 模式下連鎖照 seed 擲骰、不看 on 條件。"
    }
  },
  "effects": {
    "cure": {
      "label": "對症",
      "resolves": true,
      "severityStep": -3,
      "complaintUnit": -25,
      "note": "事件解除，民怨大幅下降。"
    },
    "assist": {
      "label": "輔助",
      "resolves": false,
      "severityStep": -1,
      "complaintUnit": -12,
      "note": "嚴重度 −1；若降到 0 視同解除。"
    },
    "palliative": {
      "label": "治標",
      "resolves": true,
      "severityStep": -3,
      "complaintUnit": -10,
      "rebound": {
        "delayCycles": 1,
        "chainOn": "palliative"
      },
      "note": "本季暫時解除，但留下反彈風險（下季同事件權重上升）。"
    },
    "neutral": {
      "label": "無關",
      "resolves": false,
      "severityStep": 0,
      "complaintUnit": 0,
      "note": "點數白花，事件照舊。"
    },
    "backfire": {
      "label": "反效果",
      "resolves": false,
      "severityStep": 0,
      "complaintUnit": 8,
      "note": "讓情況更糟：該領域民怨額外 +8×嚴重度係數。"
    }
  },
  "effectRank": [
    "cure",
    "assist",
    "palliative",
    "neutral",
    "backfire"
  ],
  "severityScale": {
    "1": 0.8,
    "2": 1.0,
    "3": 1.2
  },
  "resolutionRule": {
    "cured": "任一政策 cure",
    "assisted": "無 cure，有 assist（嚴重度下降，降到 0 視同解除）",
    "palliative": "無 cure/assist，有 palliative",
    "backfired": "無以上，且有 backfire",
    "ignored": "其他"
  },
  "complaintBridge": "事件層只提供：resolved（餵給 complaint.js 的「已解決」）、severityAfter、extraDelta（僅 backfire +8×係數）與連鎖；民怨主要仍由 complaint.js 結算，避免重複計算。",
