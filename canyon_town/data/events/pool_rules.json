  "policyMatrixNote": "領域層 fallback：只給 assist/palliative/neutral，不得 cure／backfire；實際回應以 data/events/event_policy_map.json（逐事件對照表）為準。",
  "vars": {
    "place": {
      "pool": [
        "峽口",
        "橋頭",
        "老街口",
        "北坡路",
        "南岸巷"
      ]
    },
    "day": {
      "pool": [
        "週五",
        "週末",
        "連假第一天"
      ]
    },
    "n": {
      "range": [
        3,
        7
      ]
    },
    "pct": {
      "range": [
        20,
        60
      ]
    },
    "mm": {
      "range": [
        80,
        140
      ]
    },
    "note": "事件 vars 可覆寫：[min,max] 為整數範圍。同一事件內的 {n} 在文章與對話中一致。"
  },
  "conditionTypes": {
    "complaint": "{type,domain,gte|lt}",
    "ignored": "{type,domain,gte} 連續被忽略季數",
    "policy": "{type,id,owned:true|false,since?:\"before\"|\"this\"}（before=先前已買；this=本季剛買）",
    "season": "{type,in:[...]}",
    "event": "{type,id,active:true} 本季有此事件；或 {type,id,lastResolution:[...]} 上季此事件的結果",
    "combinators": "{all:[]} {any:[]} {not:{}}"
  },
  "chainRule": {
    "when": "結報時，事件結果（cured/assisted/palliative/ignored/backfired 對應 on 的 ignored/palliative/backfire…）命中 chain.on → 以 chance 擲骰；成功則排入 pending。",
    "on": [
      "ignored",
      "palliative",
      "backfired"
    ],
    "delay": {
      "0": "後續（aftermath）：同季結報立刻出現，當作未處理的額外事件",
      "1": "下季強制出現"
    }
  },
  "streetRound": {
    "durationSec": 30,
    "bubbleSec": 2.6,
    "gapSec": 0.4,
    "slots": 10,
    "trueClueTarget": {
      "min": 5,
      "max": 8
    },
    "rules": [
      "先放入所有事件的真線索（最多 8）",
      "每個事件最多 1 則假線索／半真線索（傳聞），其餘位置補怨言",
      "同一 NPC 不連續說話",
      "不足 5 則真線索時，從 G.DATA.clues 靜態線索補同領域線索",
      "順序用 seed 洗牌，但同一事件的真線索盡量錯開"
    ]
  },
  "dialogueCategories": {
    "chat": "閒聊",
    "complaint": "怨言",
    "clue": "關鍵線索",
    "rumor": "傳聞"
  },
  "legacyBridge": "抽到有 legacyEventId 的事件時，把該 id 放進 ctx 的 fired 清單，events.js / policy.solves 邏輯照舊；其他事件由 G.EventPool.settle 負責。"
}
